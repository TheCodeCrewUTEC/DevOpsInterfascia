POSTGRES_DB=interfascia
POSTGRES_USER=interfascia
POSTGRES_PASSWORD=
DATABASE_URL=
# Ollama de la PC que responde Qwen. Vacío usa localhost:11434.
# Ejemplo en la misma red: http://192.168.1.20:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b-instruct

# Keycloak y Auth.js. Generar cada secreto con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_FRONTEND_CLIENT_SECRET=
AUTH_SECRET=

# Base de datos de Keycloak dentro del contenedor interfascia-db
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=

# SMTP para el código de verificación por correo (segundo factor del login).
# Con Gmail: activá la verificación en 2 pasos de la cuenta y creá una contraseña de aplicación
# en https://myaccount.google.com/apppasswords (16 letras, sin espacios). No es la contraseña de la cuenta.
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=
# Opcionales
# SMTP_FROM=tu-cuenta@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
